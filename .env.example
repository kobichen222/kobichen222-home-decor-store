# Copy to .env.local for local development. On Vercel, set these per
# environment (Production / Preview / Development) in Project Settings.

# Public site URL (canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API. Local values are printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Payments. "mock" is a simulator for development and Preview; it refuses
# to run on Vercel Production. A real provider adapter is added in stage 7.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
# Demo sites only: lets the simulator run on Vercel Production. Remove before selling for real.
# ALLOW_MOCK_PAYMENTS=true

# Shared secret for /api/cron/* (Vercel sends it as "Authorization: Bearer …")
CRON_SECRET=

# E-mail (Resend). Without these, e-mails are not sent; every attempt is
# still recorded in the admin's integration log.
# RESEND_API_KEY=
# EMAIL_FROM="בית ועיצוב <orders@your-domain.co.il>"
